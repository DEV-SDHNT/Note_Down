@import url('https://fonts.googleapis.com/css2?family=Single+Day&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Schoolbell&display=swap');
*{
    margin: 0;
    text-align: left;
    font-family: monospace;
}
body{
    background-color: transparent;
    height: 100vh;
    width:100vw;
    text-align: left;
    font-family: monospace;
    margin: 0;
}

.main{
    position: relative;
    background: white;
    height: 100vh;
    width: 100vw;
}

.main .menu-bar{
    top:-6vh;
    background: #000;
    position: fixed;
    height: 50px;
    width: 80px;
    left:50%;
    translate:-50%;
    display: flex;
    border-radius: 30px;
    justify-content: space-between;
    z-index: 3;
}
.dynamicbar{
    position: fixed;
    top:0vh;
    left:50%;
    translate:-50%;
    background: #0000;
    height:40px;
    padding:0.5vh;
    width: 90px;
    z-index: 4;
}
.main .dynamicbar:hover .menu-bar{
    animation: open-navbar 0.5s forwards ease-out;
}
.main .dynamicbar:focus .menu-bar{
    animation: open-navbar 0.5s forwards ease-out;
}
@keyframes open-navbar{
    0%{
        width: 10vw;
    }
    100%{
        top:1vh;
        background: #0000;
        width: 98vw;
        height: fit-content;
        padding:0.4vh;
    }
}

.main .menu-bar .file{
    background: transparent;
    color: #0000;
    backdrop-filter:blur(0px);
    width: fit-content;
    padding-inline:1vw;
    padding-block:0.5vh;
    box-shadow: #7770 0 0 0px;
    border-radius: 30px;
    display: flex;
    align-content: center;
    align-items: center;
    /* border-bottom-left-radius: 20px; */
    /* border-bottom-right-radius: 20px; */
}

.dynamicbar:hover .file{
    animation: open-file-name 0.5s forwards ease-out;
}
.dynamicbar:focus .file{
    animation: open-file-name 0.5s forwards ease-out;
}
@keyframes open-file-name{
    from{
        display: none;
        color:#0000;
        box-shadow: #7770 0 0 8px;
        backdrop-filter:blur(0px);
    }
    to{
        display: flex;
        color: #000;
        background: white;
        box-shadow: #777 0 0 8px;
        backdrop-filter:blur(4px);
    }
}

.main .menu-bar .file .file-name{
    font-weight: bold;
    font-size: 0px;
    font-family: Monospace;
}
.dynamicbar:hover .file-name{
    animation:openfilename 0.5s forwards ease-out;
}
@keyframes openfilename{
    from{
        font-size: 0px;
    }
    to{
        font-size: 13px;
    }
}

.main .menu-bar .menu-buttons{
    background: transparent;
    backdrop-filter:blur(4px);
    width: fit-content;
    display: none;
    justify-content: center;
    gap:1vh;
    overflow: scroll;
    scrollbar-width:none;
    box-shadow: #7770 0 0 8px;
    padding-inline:0.2vw;
    padding-block:0.4vh;
    border-radius: 40px;
    /* border-bottom-left-radius: 20px; */
    /* border-bottom-right-radius: 20px; */
}
.dynamicbar:hover .menu-buttons{
    display:flex;
    box-shadow: #777 0 0 8px;
    animation: open-menubuttons 0.5s forwards ease-out;
}
.dynamicbar:focus .menu-buttons{
    display:flex;
    box-shadow: #777 0 0 8px;
}

@keyframes open-menubuttons{
    from{
        box-shadow: #7770 0 0 0;
    }
    to{
        box-shadow:#888 0 0 8px;
    }
}

.main .menu-bar .menu-buttons button{
    margin: 0;
    padding: 1vh;
    border: none;
    height: fit-content;
    color: #000;
    border-radius: 20px;
    display: flex;
    align-content:center ;
    background: transparent;
}
.dynamicbar:hover button{
    animation:open-buttons 0.7s forwards ease-out;
}
.dynamicbar:focus button{
    animation:open-buttons 0.7s forwards ease-out;
}
@keyframes open-buttons{
    from{
        color:transparent;
    }
}
.main .dynamicbar:hover button:hover {
    background: #000;
    color: #fff;
}

.main .dynamicbar:focus button:focus{
    background:#000;
    color:#fff;
}
.main .workspace{
    background: transparent;
    position: relative;
    width: 99vw;
    padding:0;
    display: flex;
    flex-direction: row;
}

.main .workspace .editor{
    background: transparent;
    min-width: 40vw;
    height: 100vh;
    font-size:16px;
    padding-block:1vh;
    padding-inline:1vw;
    overflow: scroll;
    resize:horizontal;
    scrollbar-width:none;
    box-shadow: #999 -1px 0 10px;
}
.main .preview{
    width: 50vw;
    z-index: 1;
    background: white;
    padding:1vh;
    overflow: scroll;
    scrollbar-width:none;
}

.main .workspace .preview h1{
    font-size:46px;
}
.main .workspace .preview h2{
    font-size: 36px;
}
.main .workspace .preview h3{
    font-size: 26px;
}
.main .workspace .preview h4{
    font-size: 20px;
}
.main .workspace .preview p{
    font-size:18px;
}
.main .workspace .preview li{
    font-size:18px;
}
.main .workspace .preview a{
    color:#333;
}
.main .workspace .preview hr{
    width: 30%;
    margin-top: 5px;
    margin-bottom: 8px;
    color: #888;
    position: relative;
}

.mode{
    position: fixed;
    bottom:0.1vh;
    right:0.1vw;
    background: transparent;
    padding:1vh;
    z-index: 5;
}

.mode button{
    z-index: 5;
    display:flex;
    justify-content: center;
    align-items: center;
    background: white;
    color:black;
    border: none;
    border-radius: 40px;
    padding:1vh;
    box-shadow: #999 0 0 6px;
}
.mode button:hover{
    background: black;
    color:white;
}
.mode button:focus{
    background: black;
    color:white;
}

.modal{
    position: fixed;
    left:50%;
    top:50%;
    translate:-50% -50%;
    backdrop-filter:blur(5px);
    height: max-content;
    width:max-content;
    display: flex;
    align-items: left;
    justify-content: left;
    z-index: 5;
}

.modal .modal-container{
    background-color: #000;
    color: #fff;
    padding: 5vh;
    border:solid gray 1px;
    border-radius: 25px;
    width: max-content;
    display: flex;
    flex-direction: column;
    gap:2vh;
    
}

.modal .modal-container ul{
    list-style: none;
    display: flex;
    max-height: 25vh;
    overflow-y: scroll;
    flex-direction: column;
    gap:0.5vh;
    padding:0px;
}

.modal .modal-container ul li{
    display: flex;
    flex-direction: row;
    background-color: #FFF;
    color: #000;
    border-radius: 200px;
    width: 20vw;
    margin: 0;
    height: min-content;
    justify-content:space-around;
    padding: 1vh;
    align-items: center;
}

.modal .modal-container ul li:hover{
    border-bottom: 1px solid #eee;
    animation: hover 0.5s ease forwards;
}
@keyframes hover {
    from{
        background: #fff;
    }
    to{
        background: #666;
    }
}


.modal .modal-container .buttons{
    display: flex;
    justify-content: left;
    gap: 1vw;
}
.modal .modal-container button{
    color: #000;
    background: #eee;
    display: flex;
    justify-content: left;
    border-radius: 5px;
    border: none;
    padding: 1vh;
    width: max-content;
}

.modal .modal-container .delete-button{
    background-color: #111;
    color: #fff;
    margin:0;
    display: flex;
    border: none;
    padding: 10px;
    border-radius: 400px;
    width: fit-content ;
}

.modal .modal-container input{
    padding: 10px;
    position: relative;
    width: max-content;
    border-radius: 10px;
    border: none;
    font-size: 16px;
}


@media (max-width:786px) and (max-height:1080px) {
    .main{
        display: flex;
        width:100vw;
    }
    .main .workspace{
        display: flex;
        align-content: center;
        align-items: center;
        flex-direction: column;
        overflow-y: scroll;
        scrollbar-width:none;
    }

    .main .workspace .editor{
        width: 96vw;
        min-height: 30vh;
        resize: auto;
        padding:1.5vh;
        padding-inline:2vw;
        overflow: scroll;
        border:solid 1px grey;
        scrollbar-width:none;
    }
    .main .workspace .preview{
        width: fit-content;
        min-height: 20vh;
        overflow: scroll;
        scrollbar-width:none;
    }
    .main .menu-bar{
        top:-4vh;
    }
    .main .menu-bar .file{
        width: fit-content;
        padding: 1vh;
    }
    .modal .modal-container{
        width: max-content;
    }
    .modal .modal-container ul li{
        width: max-content;
        justify-content: space-around;
        gap:3vh;
    }
    .modal .modal-container  button{
        padding: 1vh;
    }
} 
