@import url('https://fonts.googleapis.com/css2?family=Single+Day&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Schoolbell&display=swap');
*{
    margin: 0;
    text-align: left;
    font-family: monospace;
}
body{
    background-color: transparent;
    height: 100vh;
    width:100vw;
    text-align: left;
    font-family: monospace;
    margin: 0;
}

.main{
    display: flex;
    flex-direction: column;
    background: white;
    height: 100vh;
    width: 100vw;
}

.main .menu-bar{
    top:3px;
    background: transparent;
    position: fixed;
    height: fit-content;
    width: 98vw;
    margin-left: 10px;
    display: flex;
    border-radius: 30px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    justify-content: space-between;
    gap:2vh;
    z-index: 2;
}

.main .menu-bar .file{
    background: transparent;
    backdrop-filter:blur(4px);
    width: fit-content;
    padding-inline:1vw;
    padding-block:0.5vh;
    box-shadow: #777 0 0 8px;
    border-radius: 30px;
    display: flex;
    align-content: center;
    align-items: center;
    /* border-bottom-left-radius: 20px; */
    /* border-bottom-right-radius: 20px; */
}

.main .menu-bar .file .file-name{
    color: black;
    font-weight: bold;
    font-size: 13px;
    font-family: Monospace;
}

.main .menu-bar .menu-buttons{
    background: transparent;
    backdrop-filter:blur(4px);
    width: fit-content;
    display: flex;
    justify-content: center;
    gap:1vh;
    overflow: scroll;
    scrollbar-width:none;
    box-shadow: #777 0 0 8px;
    padding-inline:0.1vw;
    padding-block:0.4vh;
    border-radius: 40px;
    /* border-bottom-left-radius: 20px; */
    /* border-bottom-right-radius: 20px; */
}

.main .menu-bar .menu-buttons button{
    margin: 0;
    padding: 1vh;
    border: none;
    height: fit-content;
    color: #000;
    border-radius: 20px;
    display: flex;
    align-content:center ;
    background: transparent;
}

.main .menu-bar button:hover,button:focus{
    background: #000;
    color: #aaa;
}

.main .workspace{
    background: transparent;
    position: fixed;
    margin-top:6vh;
    padding:0;
    height:100vh;
    width:100vw;
    display:flex;
    flex-direction: row;
    justify-content: start;
}

.main .workspace .editor{
    background: transparent;
    position: relative;
    font-size: 18px;
    font-family: "SchoolBell","Single Day",cursive;
    height: 92vh;
    width:45vw;
    resize: none;
    text-wrap:wrap;
    padding:1vh;
    border-radius: 11px;
}
.main .workspace .preview{
    background: transparent;
    width:54vw;
    height: 92vh;
    text-wrap:wrap;
    padding:1vh;
    border-radius: 11px;
    font-family: "SchoolBell","Single Day",cursive;
}

.main .workspace .preview h1{
    font-size:46px;
}
.main .workspace .preview h2{
    font-size: 36px;
}
.main .workspace .preview h3{
    font-size: 26px;
}
.main .workspace .preview h4{
    font-size: 20px;
}
.main .workspace .preview p{
    font-size:18px;
}
.main .workspace .preview li{
    font-size:18px#;
}
.main .workspace .preview a{
    color:#333;
}
.main .workspace .preview hr{
    width: 30%;
    margin-top: 5px;
    margin-bottom: 8px;
    color: #888;
    position: relative;
}
.modal{
    position: fixed;
    left:50%;
    top:50%;
    translate:-50% -50%;
    backdrop-filter:blur(5px);
    height: max-content;
    width:max-content;
    display: flex;
    align-items: left;
    justify-content: left;
    z-index: 5;
}

.modal .modal-container{
    background-color: #000;
    color: #fff;
    padding: 5vh;
    border:solid gray 1px;
    border-radius: 25px;
    width: max-content;
    display: flex;
    flex-direction: column;
    gap:2vh;
    
}

.modal .modal-container ul{
    list-style: none;
    display: flex;
    max-height: 25vh;
    overflow-y: scroll;
    flex-direction: column;
    gap:0.5vh;
    padding:0px;
}

.modal .modal-container ul li{
    display: flex;
    flex-direction: row;
    background-color: #FFF;
    color: #000;
    border-radius: 200px;
    width: 20vw;
    margin: 0;
    height: min-content;
    justify-content:space-around;
    padding: 1vh;
    align-items: center;
}

.modal .modal-container ul li:hover{
    border-bottom: 1px solid #eee;
    animation: hover 0.5s ease forwards;
}
@keyframes hover {
    from{
        background: #fff;
    }
    to{
        background: #666;
    }
}


.modal .modal-container .buttons{
    display: flex;
    justify-content: left;
    gap: 1vw;
}
.modal .modal-container button{
    color: #000;
    background: #eee;
    display: flex;
    justify-content: left;
    border-radius: 5px;
    border: none;
    padding: 1vh;
    width: max-content;
}

.modal .modal-container .delete-button{
    background-color: #111;
    color: #fff;
    margin:0;
    display: flex;
    border: none;
    padding: 10px;
    border-radius: 400px;
    width: fit-content ;
}

.modal .modal-container input{
    padding: 10px;
    position: relative;
    width: max-content;
    border-radius: 10px;
    border: none;
    font-size: 16px;
}
@media (max-width:786px) and (max-height:1080px) {
    .main{
        display: flex;
        width:100vw;
    }
    .main .workspace{
        margin-top: 6vh;
        flex-direction: column;
        width: 100vw;
        height: 100vh;
    }
    .main .workspace .editor{
        width: 99vw;
        text-wrap:wrap;
        overflow-y: scroll;
        scrollbar-width:none;
    }
    .main .menu-bar .file{
        width: fit-content;
        padding: 1vh;
    }
    .main .menu-bar .menu-buttons{
        padding: 0.6vh;
        display: flex;
        gap:1vh;
    }
    .main .workspace .preview{
        position: relative;
        margin: 0;
        height:fit-content;
        width: 99vw;
        text-wrap:wrap;
        overflow-x: scroll;
        scrollbar-width:none;
        border-radius: 10px;
    }
    .modal .modal-container{
        width: max-content;
    }
    .modal .modal-container ul li{
        width: max-content;
        justify-content: space-around;
        gap:3vh;
    }
    .modal .modal-container  button{
        padding: 1vh;
    }
} 
